# CYBERNEX 10.0V — Variables de entorno del backend (EJEMPLO)
# Copia este archivo como .env y completa los valores. NUNCA subas .env a GitHub.

# Proyecto de Supabase (Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública (anon): puede usarse en el frontend; la seguridad la dan las políticas RLS.
SUPABASE_ANON_KEY=
# Clave de servicio: SOLO en el servidor. Jamás en el frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Servidor Node.js (cuando se implemente la API)
PORT=3000
ALLOWED_ORIGIN=https://TU-USUARIO.github.io

# Comprobación de reputación de enlaces (opcional, para una fase posterior)
SAFE_BROWSING_API_KEY=
# Protección anti-spam del formulario de contacto (opcional)
CAPTCHA_SECRET=
